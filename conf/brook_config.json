{
  "port": 3001,
  "worker_processes": 4,
  
  
  "http_request_timeout_ms": 1000,       // 1 SECOND
  "http_request_max_body_size": 1048576, // 1MB

  "regex_http_line": "^(GET|POST|DELETE|OPTIONS|PATCH)[ \t]+(/([a-zA-Z0-9_-]+/?)*)(\\?[^ \t\r\n]*)?[ \t]+HTTP/1\\.1\\r?",
  
  "postgres_connection_string": "host=localhost dbname=pos user=pos password=pos",
  "postgres_connection_per_worker": 2
  
}
